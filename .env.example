# EduAI Landing — 3D story configuration
# Copy to .env.local and edit. All values have code defaults matching the
# original Blender export spec, so an empty .env works out of the box.
#
# ── Model paths (relative to /public, or absolute URLs) ──
VITE_LANDING_MODEL_STUDENT=/models/student.glb
VITE_LANDING_MODEL_TEACHER=/models/teacher.glb
VITE_LANDING_MODEL_PARENT_A=/models/parent-a.glb
VITE_LANDING_MODEL_PARENT_B=/models/parent-b.glb
VITE_LANDING_MODEL_ROBOT=/models/robot.glb
#
# ── Animation clip names looked up inside each .glb ──
VITE_LANDING_CLIP_STUDENT_IDLE=idle
VITE_LANDING_CLIP_STUDENT_WAVE=waving
VITE_LANDING_CLIP_STUDENT_WALK=walking
VITE_LANDING_CLIP_STUDENT_SIT=sitting
VITE_LANDING_CLIP_STUDENT_THINK=thinking
VITE_LANDING_CLIP_STUDENT_CELEBRATE=victory
VITE_LANDING_CLIP_TEACHER_IDLE=idle
VITE_LANDING_CLIP_TEACHER_WRITE=writing
VITE_LANDING_CLIP_TEACHER_SIT=sitting
VITE_LANDING_CLIP_PARENT_IDLE=idle
VITE_LANDING_CLIP_PARENT_CLAP=clapping